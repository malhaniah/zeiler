opt_out_usage

default_platform(:android)

platform :android do
  desc "Upload the signed release and store listing to internal testing"
  lane :internal do
    upload_to_play_store(
      track: "internal",
      release_status: "completed",
      aab: "src-tauri/gen/android/app/build/outputs/bundle/universalRelease/app-universal-release.aab",
      metadata_path: "fastlane/metadata/android",
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      skip_upload_changelogs: false
    )
  end

  desc "Update promotional images without replacing the uploaded AAB"
  lane :assets do
    upload_to_play_store(
      track: "internal",
      metadata_path: "fastlane/metadata/android",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc "Promote the current internal release to closed testing"
  lane :closed do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "alpha",
      track_promote_release_status: "draft",
      changes_not_sent_for_review: false,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end

  desc "Promote the current internal release to Play production"
  lane :production do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      changes_not_sent_for_review: false,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end
end
